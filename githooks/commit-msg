#!/bin/sh
# commit-msg hook (safety net for the project attribution rule).
#
# This repo is the work of three people and the history must read that way.
# Before a commit is created this hook:
#   1. deletes any  Co-Authored-By: / Authored-By: / Signed-off-by:  trailer
#   2. deletes any "Generated with" / "generated by" attribution line
#   3. deletes any line carrying the robot marker emoji
#   4. rejects the commit outright if a tool/vendor attribution word survives
#
# This is the tracked master copy. Every clone must install it once:
#   sh scripts/install_hooks.sh      (or) git config core.hooksPath githooks
msg_file="$1"
tmp_file="$msg_file.codemix.tmp"

# 1-3: strip attribution lines.
grep -ivE '^[[:space:]]*(co-)?authored-by:' "$msg_file" \
  | grep -ivE '^[[:space:]]*signed-off-by:' \
  | grep -ivE 'generated (with|by)' \
  | grep -v '🤖' > "$tmp_file"
mv "$tmp_file" "$msg_file"

# 4: hard stop if an attribution word is still in the body.
if grep -iqE 'co-authored|assistant|copilot|chatgpt|openai|anthropic|claude|\bllm\b' "$msg_file"; then
  echo "commit-msg: tool attribution is not allowed in this repo." >&2
  echo "  Rewrite the message in plain first-person engineering voice." >&2
  echo "  See the team rules doc, section 4." >&2
  exit 1
fi

exit 0
