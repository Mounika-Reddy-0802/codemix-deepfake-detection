.env.git
# ^^^ LINE 1 IS MANDATORY: never commit git identities / GitHub PATs. ^^^

# --- Other secrets ---
.env
.env.local
*.pem

# --- Signed ethics artefacts: CONFIDENTIAL, never committed ---
# The signed mentor note carries real handwritten signatures of the team and the
# faculty mentor. It lives only on team machines and is shared privately, never
# through this repository. src/data/ethics_gate.py reads it from the working tree,
# so the gate still opens locally without the file ever entering git history.
# The BLANK form (mentor_signoff_form.md / .docx) is not confidential and stays tracked.
docs/ethics/*.pdf
docs/ethics/*.png
docs/ethics/*.jpg
docs/ethics/*.jpeg

# The transfer bundle carries a COPY of that signed PDF, plus reference and
# generated audio, so it is exactly what must never be committed -- and unlike
# docs/ethics/ it is not covered by any rule above. It sits in the repo root
# while a machine is being set up, one `git add -A` away from putting real
# signatures into git history.
gpu-laptop-bundle/
gpu-laptop-bundle.zip

# --- Large corpora & model artifacts: local / Kaggle only ---
# Track the directory skeleton (.gitkeep) but ignore all real data files.
data/**
!data/**/
!data/**/.gitkeep
!data/**/README.md

# Manifests are metadata, not data: small text files that must be versioned so a
# frozen split (speaker pools, dataset manifests) is reproducible and reviewable.
# Audio never lives here.
!data/manifests/*.csv

# ...except the raw clip index. It is ~14 MB of absolute machine-local paths
# (C:\dfdata\...), so it is neither portable nor reviewable, and it regenerates in
# about a minute: `python -m src.data.corpora --data-root <your DATA_ROOT>`.
# The derived speaker_ranking.csv and the frozen speaker_pools.csv ARE committed.
data/manifests/clip_index.csv

# Same reason: the train/dev/eval manifests carry an absolute `filepath` per row,
# so a committed copy would point at one machine's disk and silently resolve to
# nothing on another. They are rebuilt from clip_index.csv + speaker_pools.csv,
# and speaker_pools.csv (the part that must not drift) IS committed and hashed.
data/manifests/train.csv
data/manifests/dev.csv
data/manifests/eval.csv
data/manifests/asvspoof_train.csv
data/manifests/asvspoof_dev.csv
data/manifests/asvspoof_eval.csv

checkpoints/**
!checkpoints/**/
!checkpoints/**/.gitkeep

wandb/

# --- Generated audio (never committed, from any generated dir) ---
**/generated/**/*.wav

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

# --- Notebooks ---
.ipynb_checkpoints/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
~$*
*.swp
.idea/
.vscode/
.claude/

# --- Planning documents and review decks: shared privately, not through git ---
# These are working documents for the team and the mentor (task IDs, owners,
# review slides, the standing workflow contract). They live on team machines and
# in the shared drive; the repo carries the code and the results, not the plan.
Project_Plan_12_Weeks.docx
PROJECT_PLAN_12_WEEKS.md
PROJECT_PLAN_V2_AFFECTDF.md
Updated_Project_Plan_v2_AffectDF.docx
Review1_Presentation_v3.pptx
GIT_RULES.md
CLAUDE.md

# Run logs: machine-local stdout from training/eval, regenerated every run.
logs/
