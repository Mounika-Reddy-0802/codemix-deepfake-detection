# .env.example — copy to .env and fill in. NEVER commit the real .env.
# Git identities + GitHub PATs live in a SEPARATE file, .env.git (also gitignored).
#
#   cp .env.example .env
#
# Every variable used anywhere in the project is documented below with a
# placeholder. Load with python-dotenv or `set -a; . ./.env; set +a`.

# ============================================================================
# Weights & Biases (experiment tracking) — Week 1 (M), used from Week 3
# ============================================================================
WANDB_API_KEY=your-wandb-api-key
WANDB_PROJECT=codemix-deepfake-detection
WANDB_ENTITY=your-wandb-team-or-username
# Set to "offline" on Kaggle if the run has no internet, else "online".
WANDB_MODE=online

# ============================================================================
# Hugging Face (streaming eval-only Indic corpora + model downloads) — Week 1 (L)
# ============================================================================
# Fine-grained HF token with "read" access; some datasets are gated and need
# you to accept their terms on the dataset page first.
HF_TOKEN=hf_your_read_token
HUGGING_FACE_HUB_TOKEN=hf_your_read_token

# ============================================================================
# Twilio (LIVE CALL) — see live_call/README.md, section 2. Placeholders only.
# ============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_NUMBER=+1XXXXXXXXXX          # the trial US number
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-twilio-api-key-secret
# Verified teammate phone numbers that may receive trial calls/SMS (E.164).
RECEIVER_NUMBER=+91XXXXXXXXXX

# ============================================================================
# Local dev server + tunneling (WebRTC harness Weeks 1-5, Twilio webhooks Wk6)
# ============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Public URL that Twilio/ngrok points at your local FastAPI server.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
NGROK_AUTHTOKEN=your-ngrok-authtoken

# ============================================================================
# Live detection server (live_call/server.py)
# ============================================================================
# Detector checkpoint the server loads (S2 phone-line adapter trained with RVC).
DFD_CHECKPOINT=/path/to/data/checkpoints/lora_norm_rvc_channel_best.pt
# Frozen operating point, chosen by src/inference/calibrate.py.
DFD_THRESHOLD_FILE=configs/threshold.yaml
# cpu (default) or cuda.
DFD_DEVICE=cpu
# Folder built by scripts/prepare_demo_clips.py (audio + demo_clips.json), outside git.
DEMO_CLIPS_DIR=/path/to/data/demo_clips
# Set to 0 only for local testing without a public URL; Twilio signatures are checked otherwise.
TWILIO_VALIDATE=1

# ============================================================================
# Inference
# ============================================================================
# Path to the exported int8 ONNX detector (set once Week 5 export exists).
ONNX_MODEL_PATH=checkpoints/detector_int8.onnx
